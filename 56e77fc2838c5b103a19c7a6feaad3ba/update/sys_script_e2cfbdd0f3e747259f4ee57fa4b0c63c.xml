        <script><![CDATA[(function executeRule(current, previous /*, gs */) {
    // Flag SLA breach when the expected resolution date has passed and the case
    // is still open. Escalation/notification is handled by Phase 4 flows.
    var status = current.getValue('case_status');
    if (status === 'resolved' || status === 'closed') {
        return;
    }
    var exp = current.getValue('expected_resolution_date');
    if (!exp) {
        return;
    }
    var expDt = new GlideDateTime(exp);
    var now = new GlideDateTime();
    if (expDt.getNumericValue() < now.getNumericValue()) {
        if (current.getValue('sla_breach_flag') !== '1') {
            current.setValue('sla_breach_flag', true);
        }
    }
})(current, previous);
]]></script>
