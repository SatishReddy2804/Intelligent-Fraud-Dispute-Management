        <script><![CDATA[(function executeRule(current, previous /*, gs */) {
    // Route the case when no group has been assigned yet.
    if (current.getValue('assigned_group') === '' || current.getValue('assigned_group') === null) {
        var engine = new bfd_RoutingEngine();
        var res = engine.route(current);
        if (res && res.sla_hours > 0) {
            engine.computeExpectedResolution(current, res.sla_hours);
        }
    }
})(current, previous);
]]></script>
