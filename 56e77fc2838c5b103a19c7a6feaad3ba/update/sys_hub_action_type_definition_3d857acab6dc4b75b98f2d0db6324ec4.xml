        <value>/**
 * Rejection path: clears provisional_credit_flag / provisional_credit_amount,
 * resets card_action to 'none' when a permanent block was requested, and puts
 * case_status back to under_investigation.
 */
(function execute(inputs, outputs) {
    outputs.reverted = new bfd_FlowSupport().revertRequestedAction(inputs.caseSysId) ? 'true' : 'false';
})(inputs, outputs);
</value>
