        <value>/**
 * Runs bfd_DuplicateDetector and returns the customer-friendly message.
 * The after-insert business rule has already linked duplicate_of_case.
 */
(function execute(inputs, outputs) {
    var result = new bfd_FlowSupport().detectDuplicate(inputs.caseSysId);
    outputs.isDuplicate = result.isDuplicate ? 'true' : 'false';
    outputs.message = result.message || '';
})(inputs, outputs);
</value>
