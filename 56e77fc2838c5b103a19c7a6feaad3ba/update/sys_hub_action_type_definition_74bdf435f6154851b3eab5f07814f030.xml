        <value>/**
 * Delegates to bfd_CaseUtils.highValueApprovalRequired() (threshold 500):
 * provisional_credit_amount &gt; 500, card_action = permanent_block, or
 * recovery_amount &gt; 500.
 */
(function execute(inputs, outputs) {
    var result = new bfd_FlowSupport().highValueApprovalRequired(inputs.caseSysId);
    outputs.approvalRequired = result.required ? 'true' : 'false';
    outputs.reason = result.reason || '';
})(inputs, outputs);
</value>
